            "body": {
              "mode": "raw",
              "raw": "{\n  \"ContainerName\": \"_UpX\",\n  \"CorsPolicy\": [\n    {\n      \"AllowedOrigins\": [\n        \"so\u00a3\"\n      ],\n      \"AllowedHeaders\": [\n        \"\u0098\u00d3\u00e7\u00d0\",\n        \"\u009b\u009a\",\n        \"\u00be\u00ff\u00b7\",\n        \"C\u0092\u00dc\",\n        \"YR4\",\n        \"@\",\n        \"\u0095F\u00f7\u00e8rz\",\n        \"B\u0098@\",\n        \":\u00d8\u00bd\u00d7\u00c2\u008eB\u00df\u00ea\u00e6\",\n        \"<\u00dc|,\u00a5XQ\u00f7\u0088\u00ea\",\n        \"\u00ca\u0093\u009ce\u008a\u00ae\",\n        \"\u00f0\u00a1\u00b2\",\n        \"\u00a0\u00f1\u00b7\u00b7\u00fc\",\n        \"\u00f04p\u00b0\",\n        \"\u00fc\u00c0<\u00f9\u00fc\u00c0JRQ\u00c2\",\n        \"\u0092\u009c\u00fb\u008ai\",\n        \"1e\",\n        \"\u00ea\u00a51\u00ba[\u00c5\u00e4\u00b1\u00c4\",\n        \"#&D5\u00aan\u008cV\u00b8-a\",\n        \"G\u00a9\u009a\u00ff\u00dfO\u00dby\u00b1)\u00c3\"\n      ],\n      \"AllowedMethods\": [\n        \"DELETE\"\n      ],\n      \"MaxAgeSeconds\": \"<integer>\",\n      \"ExposeHeaders\": [\n        \"y\u0092\u00ec\u00f0\u00c3\u00da>\",\n        \"\u00a4\u0094\",\n        \"\u008cq\u008f\",\n        \"+\u00dfe\u00cb'7M\",\n        \"\u00fb\u00e1\u0091-8\",\n        \"z~\",\n        \"\u00ad\u009aa5\u00afG\u00b6\u00ba\u00fb\",\n        \"?\",\n        \"\u00a1\u00c4\u00b2\u00ca- 1\u00c5\u00a0\",\n        \"d\u00c3\u00b8\u00adxbS\u00df\",\n        \"\u00cfHu\u00fd>\u008a#\u008eM\",\n        \"\u008d\u00d4\u00f5\u009a\u0082\",\n        \"\u0084\u00acc\u00c5\",\n        \"[\u00d7\u00d8%\",\n        \"\u0098\u00c7]J\u00c9\u00a3\",\n        \"\\\"\u0090\u00d3p\u00ad\u00ab\u00fd\",\n        \"\u00d1\u00efKi\u00d6+\",\n        \"Z\u00deH\",\n        \"\u00e2\u009b\",\n        \"\u00a8$\u00f1\u00dc\u00c6\u009dI\"\n      ]\n    }\n  ]\n}",
